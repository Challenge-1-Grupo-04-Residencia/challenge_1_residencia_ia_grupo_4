{
  "manifest_version": 3,
  "name": "Senhora Vera",
  "version": "0.1.0",
  "description": "Analisa o conteúdo de páginas e apresenta uma classificação de veracidade.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_title": "Ver reputação do site",
    "default_popup": "popup.html"
  }
}